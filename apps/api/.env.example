# Groq — agent LLM only (KEY_2 used on 429 / TPM rate limit)
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-20b

# Gemini — embeddings only
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/parcelpilot

# Vector index (local persisted Chroma)
CHROMA_PATH=./.chroma

# Candidate data pack (PDFs + xlsx) — folder is `Data/` at repo root
DATA_PATH=../../Data

# Auth
JWT_SECRET=change-me-in-dev
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Snapshot clock (all time-based logic)
SNAPSHOT_TZ=Asia/Kolkata
SNAPSHOT_AT=2026-08-16T11:00:00+05:30

# CORS
CORS_ORIGINS=http://localhost:3000
